{
  "name": "python-visual-lab",
  "private": true,
  "version": "2.0.0",
  "description": "Python Visual Lab — Interactive 30 Days of Python Offline Desktop Edition",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "npm run sync-pyodide && vite build",
    "preview": "vite preview",
    "sync-pyodide": "node scripts/sync-pyodide.mjs",
    "postinstall": "node scripts/sync-pyodide.mjs",
    "electron:dev": "node scripts/electron-dev.mjs",
    "electron:pack": "npm run build && electron-builder --dir",
    "electron:build": "npm run build && electron-builder --win --x64 --publish never",
    "clean": "rm -rf dist release server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@fontsource/fira-code": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "codemirror": "^6.0.2",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pyodide": "0.27.8",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  },
  "author": "Python Visual Lab",
  "repository": {
    "type": "git",
    "url": ""
  },
  "build": {
    "appId": "com.pythonvisuallab.desktop",
    "productName": "Python Visual Lab",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.*",
      "!dist/**/*.map"
    ],
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      }
    ],
    "asar": true,
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "fileAssociations": [
        {
          "ext": "py",
          "name": "Python Script",
          "role": "Editor"
        }
      ]
    },
    "nsis": {
      "artifactName": "PythonVisualLab-Setup-${version}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Python Visual Lab"
    },
    "portable": {
      "artifactName": "PythonVisualLab-Portable-${version}.${ext}"
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.education"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Education",
      "target": [
        "AppImage"
      ]
    }
  }
}
